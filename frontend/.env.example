# Browser memakai proxy same-origin Nuxt agar cookie session dan CSRF bekerja tanpa konfigurasi tambahan.
NUXT_PUBLIC_API_BASE=/api/v1
# URL internal Fastify yang dipakai route proxy Nuxt pada development dan production.
NUXT_API_SERVER_BASE=http://127.0.0.1:3001/api/v1
# Paksa seed localStorage untuk build statis demo, misalnya GitHub Pages.
NUXT_PUBLIC_OFFLINE_DEMO=false
# Gunakan GPL hanya bila aplikasi didistribusikan sesuai GPL; isi license key CKEditor komersial untuk aplikasi proprietary.
NUXT_PUBLIC_CKEDITOR_LICENSE_KEY=GPL

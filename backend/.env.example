NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=mysql://marketplace_app:change-this-local-password@127.0.0.1:3306/marketplace_dev
# MIGRATION_DATABASE_URL=mysql://marketplace_migrator:replace-password@127.0.0.1:3306/marketplace_dev
DATABASE_CONNECTION_LIMIT=10
DATABASE_TIMEZONE=Z
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:3001
SESSION_SECRET=replace-with-at-least-32-random-characters
# Independently generated keys are mandatory in production.
# Generate each key separately with at least 32 random bytes; never reuse SESSION_SECRET.
# AUTH_TOKEN_SECRET=
# DATA_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
# Production behind the HTTPS reverse proxy requires both values to be true.
TRUST_PROXY=false
WORKER_CONCURRENCY=4
# File uploads fail closed when the malware scanner is unavailable.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
PROVIDER_ENVIRONMENT=SANDBOX
# MIDTRANS_SERVER_KEY=
# MIDTRANS_MERCHANT_ID=
PAYMENT_CHANNELS=qris
PAYMENT_CHANNEL_LIMITS={"qris":{"minimum_amount":1000,"maximum_amount":100000000}}
MIDTRANS_REFUND_CHANNELS=qris
MIDTRANS_MANUAL_REFUND_CHANNELS=
# BITESHIP_API_KEY=biteship_test.replace-me
# BITESHIP_ACCOUNT_ID=
# BITESHIP_WEBHOOK_TOKEN=replace-with-at-least-32-random-characters
BITESHIP_COURIERS=jne,jnt,sicepat
DISPUTE_WINDOW_HOURS=48
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Marketplace <no-reply@marketplace.test>
# SMTP_USER=
# SMTP_PASSWORD=
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
# S3_BUCKET=marketplace-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Local demo assets: S3_PUBLIC_BASE_URL=http://127.0.0.1:3000/demo-products
# Development fallback when S3 is absent. Files are written below this directory.
# LOCAL_MEDIA_DIR=../frontend/public/demo-products
# Development-only seed; define yourself before npm run db:seed.
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=
# SEED_BUYER_EMAIL=buyer@example.test
# SEED_BUYER_PASSWORD=
# SEED_VENDOR_EMAIL=vendor@example.test
# SEED_VENDOR_PASSWORD=

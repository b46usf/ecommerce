{
  "name": "marketplace-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run openapi:generate && nuxt build",
    "preview": "nuxt preview",
    "typecheck": "npm run openapi:generate && nuxt typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi:generate": "openapi-typescript ../docs/Marketplace-API-OpenAPI-v0.1.yaml -o app/api/schema.d.ts",
    "demo:images": "node scripts/generate-demo-product-images.mjs",
    "postinstall": "npm run openapi:generate && nuxt prepare",
    "audit:wireframe": "node scripts/audit-wireframe.mjs",
    "check": "npm run typecheck && npm test && npm run audit:wireframe && npm run build"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^8.2.0",
    "@nuxt/icon": "^2.5.1",
    "ckeditor5": "^48.5.0",
    "nuxt": "4.5.2",
    "openapi-fetch": "0.17.0",
    "sanitize-html": "^2.17.7",
    "sweetalert2": "^11.26.25",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.18.6",
    "@types/sanitize-html": "^2.16.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
